    {
      "name": "Create workout — seeded user",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/Workout/create"
        },
        "description": "Мутационный тест: создаёт тренировку для userId=1, который присутствует в приложенном SQL-дампе.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userId\": 1,\n  \"title\": \"Postman QA workout {{runStamp}}\",\n  \"description\": \"Created by Postman collection\",\n  \"date\": \"2026-10-11T10:00:00\",\n  \"muscleGroups\": [\n    \"Ноги\"\n  ],\n  \"durationMinutes\": 45,\n  \"difficulty\": \"medium\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('runStamp', new Date().toISOString().replace(/[:.]/g, '-'));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const j = pm.response.json();",
              "pm.test('Ответ содержит положительный id тренировки', () => pm.expect(j.id).to.be.a('number').and.to.be.above(0));",
              "if (j.id) pm.collectionVariables.set('createdWorkoutId', String(j.id));"
            ]
          }
        }
      ]
    },
