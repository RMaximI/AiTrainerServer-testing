{
  "info": {
    "_postman_id": "bc3d7564-fb3c-44de-9759-a6f23f9dbf01",
    "name": "AITrainerServer — API QA Collection",
    "description": "Коллекция Postman для функциональной и негативной проверки API AITrainerServer. Используйте запущенный экземпляр API и изолированную тестовую базу. Некоторые сценарии предназначены для проверки обработки ошибочных данных и граничных условий.\n\nBase URL из настроек запуска проекта: http://192.168.203.151:60225. В профиле также указаны https://192.168.203.151:60224 и http://192.168.203.151:60226. При запуске на другом компьютере укажите адрес своего экземпляра API.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Generate workout — valid",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/Workout/generate"
        },
        "description": "POST /api/Workout/generate. MuscleGroups сопоставляется с полем muscle_groups таблицы workout_exercises.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"dayOfWeek\": \"Monday\",\n  \"muscleGroups\": [\n    \"Ноги\"\n  ],\n  \"durationMinutes\": 45,\n  \"difficulty\": \"medium\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const json = pm.response.json();",
              "pm.test('Ответ содержит массив exercises', () => pm.expect(json.exercises).to.be.an('array'));",
              "if (Array.isArray(json.exercises)) {",
              "  pm.test('Каждое упражнение содержит id и name', () => json.exercises.forEach(e => { pm.expect(e).to.have.property('id'); pm.expect(e).to.have.property('name'); }));",
              "  pm.test('Средняя сложность задаёт 3 подхода', () => json.exercises.forEach(e => pm.expect(e.sets).to.eql(3)));",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "Generate workout — empty muscleGroups (defect repro)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/Workout/generate"
        },
        "description": "Негативный тест: текущий код обращается к MuscleGroups[0] без проверки пустого списка; тест ожидаемо может упасть на текущей реализации.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"dayOfWeek\": \"Monday\",\n  \"muscleGroups\": [],\n  \"durationMinutes\": 45,\n  \"difficulty\": \"medium\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Ожидаемый контракт: HTTP 400 для пустого списка', () => pm.response.to.have.status(400));",
              "pm.test('Сервер не возвращает необработанную ошибку 500', () => pm.expect(pm.response.code).to.not.eql(500));"
            ]
          }
        }
      ]
    },
    {
      "name": "Generate workout — multiple muscle groups (defect repro)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/Workout/generate"
        },
        "description": "Негативный/регрессионный тест: текущая реализация фильтрует упражнения только по первому элементу списка.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"dayOfWeek\": \"Monday\",\n  \"muscleGroups\": [\n    \"Ноги\",\n    \"Спина\"\n  ],\n  \"durationMinutes\": 45,\n  \"difficulty\": \"medium\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const j = pm.response.json();",
              "pm.test('Ответ корректно сформирован', () => pm.expect(j.exercises).to.be.an('array'));",
              "pm.test('Должны учитываться обе переданные группы мышц', () => {",
              "  const groups = (j.exercises || []).map(e => String(e.muscleGroups || '').toLowerCase()).join(' ');",
              "  pm.expect(groups).to.include('спина');",
              "  pm.expect(groups).to.match(/ноги|ягодиц|бедра/);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Register — create unique test user",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/Workout/register"
        },
        "description": "Создаёт уникального тестового пользователя. Проверки отсутствия пароля и положительного ID специально обнаруживают текущие дефекты регистрации.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{runEmail}}\",\n  \"username\": \"Postman QA\",\n  \"password\": \"{{runPassword}}\",\n  \"age\": 25,\n  \"weight\": 75,\n  \"height\": 180,\n  \"gender\": \"male\",\n  \"fitnessLevel\": \"intermediate\",\n  \"primaryGoal\": \"improve strength\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const email = 'qa.postman.' + Date.now() + '@example.com';",
              "pm.collectionVariables.set('runEmail', email);",
              "pm.collectionVariables.set('runEmailEncoded', encodeURIComponent(email));",
              "pm.collectionVariables.set('runPassword', 'QA_Test_Pass_2026!');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200 для новой регистрации', () => pm.response.to.have.status(200));",
              "const txt = pm.response.text();",
              "pm.test('Пароль не должен возвращаться в ответе', () => pm.expect(txt).to.not.include(pm.collectionVariables.get('runPassword')));",
              "let j = {}; try { j = pm.response.json(); } catch (e) {}",
              "pm.test('Успешный ответ должен возвращать корректный ID', () => pm.expect(j.id).to.be.a('number').and.to.be.above(0));"
            ]
          }
        }
      ]
    },
